crpf:ReviewStyle rdf:type owl:Class ;
                 crpf:isStandardBased "false"^^xsd:boolean ;
                 crpf:standardName "Custom" ;
                 rdfs:label "ReviewStyle" .


###  http://www.semanticweb.org/crpf#Reviewer
crpf:Reviewer rdf:type owl:Class ;
              rdfs:subClassOf crpf:Role .


