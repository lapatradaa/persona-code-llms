@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix : <http://www.semanticweb.org/crpf#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix crpf: <http://www.semanticweb.org/crpf#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/crpf#> .

<http://www.semanticweb.org/crpf> rdf:type owl:Ontology ;
                                   dc:source "OMB SPD-15 (1997 & 2024); U.S. Census; ONS 2021; ISO 3166-1; ISO 639; UN M49 regions; GLOBE cultural clusters; Hofstede; Tylor (1871); MeSH age groups; WHO/APA gender frameworks; ISO/IEC 25010; EF nationalities list; NIH Style Guide." ;
                                   rdfs:comment "OWL ontology for controlled reviewer personas used in metamorphic / counterfactual fairness testing of AI code-review agents." ;
                                   rdfs:label "Persona Fairness Ontology v5 (CRPF)" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/source
dc:source rdf:type owl:AnnotationProperty .


###  http://www.semanticweb.org/crpf#isStandardBased
crpf:isStandardBased rdf:type owl:AnnotationProperty ;
                     rdfs:label "is standard-based" .


###  http://www.semanticweb.org/crpf#standardName
crpf:standardName rdf:type owl:AnnotationProperty ;
                  rdfs:label "standard name" .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/crpf#counterfactualOf
crpf:counterfactualOf rdf:type owl:ObjectProperty ,
                               owl:SymmetricProperty ,
                               owl:IrreflexiveProperty ;
                      rdfs:label "counterfactualOf" .


###  http://www.semanticweb.org/crpf#hasAgeRange
crpf:hasAgeRange rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ;
                 rdfs:range crpf:AgeRange ;
                 rdfs:label "hasAgeRange" .


###  http://www.semanticweb.org/crpf#hasCulture
crpf:hasCulture rdf:type owl:ObjectProperty ;
                rdfs:range crpf:Culture ;
                rdfs:label "hasCulture" .


###  http://www.semanticweb.org/crpf#hasDomain
crpf:hasDomain rdf:type owl:ObjectProperty ;
               rdfs:range crpf:Domain ;
               rdfs:label "hasDomain" .


###  http://www.semanticweb.org/crpf#hasGender
crpf:hasGender rdf:type owl:ObjectProperty ,
                        owl:FunctionalProperty ;
               rdfs:range crpf:Gender ;
               rdfs:label "hasGender" .


###  http://www.semanticweb.org/crpf#hasGoal
crpf:hasGoal rdf:type owl:ObjectProperty ;
             rdfs:range crpf:Goal ;
             rdfs:label "hasGoal" .


###  http://www.semanticweb.org/crpf#hasNationality
crpf:hasNationality rdf:type owl:ObjectProperty ;
                    rdfs:range crpf:Nationality ;
                    rdfs:label "hasNationality" .


###  http://www.semanticweb.org/crpf#hasRace
crpf:hasRace rdf:type owl:ObjectProperty ;
             rdfs:range crpf:Race ;
             rdfs:label "hasRace" .


###  http://www.semanticweb.org/crpf#hasReviewStyle
crpf:hasReviewStyle rdf:type owl:ObjectProperty ;
                    rdfs:range crpf:ReviewStyle ;
                    rdfs:label "hasReviewStyle" .


###  http://www.semanticweb.org/crpf#hasRole
crpf:hasRole rdf:type owl:ObjectProperty ,
                      owl:FunctionalProperty ;
             rdfs:range crpf:Role ;
             rdfs:label "hasRole" .


###  http://www.semanticweb.org/crpf#hasSeniority
crpf:hasSeniority rdf:type owl:ObjectProperty ,
                           owl:FunctionalProperty ;
                  rdfs:range crpf:Seniority ;
                  rdfs:label "hasSeniority" .


###  http://www.semanticweb.org/crpf#hasHofstedeProfile
crpf:hasHofstedeProfile rdf:type owl:DatatypeProperty ;
                        rdfs:domain crpf:Culture ;
                        rdfs:range xsd:string ;
                        rdfs:label "hasHofstedeProfile" .


###  http://www.semanticweb.org/crpf#hasISO3166Code
crpf:hasISO3166Code rdf:type owl:DatatypeProperty ;
                    rdfs:domain crpf:Nationality ;
                    rdfs:range xsd:string ;
                    rdfs:label "hasISO3166Code" .


###  http://www.semanticweb.org/crpf#hasName
crpf:hasName rdf:type owl:DatatypeProperty ;
             rdfs:range xsd:string ;
             rdfs:label "hasName" .


###  http://www.semanticweb.org/crpf#hasSpecificAge
crpf:hasSpecificAge rdf:type owl:DatatypeProperty ;
                    rdfs:range xsd:integer ;
                    rdfs:label "hasSpecificAge" .


###  http://www.semanticweb.org/crpf#hasYearsExperience
crpf:hasYearsExperience rdf:type owl:DatatypeProperty ;
                        rdfs:range xsd:decimal ;
                        rdfs:label "hasYearsExperience" .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/crpf#Adolescent
crpf:Adolescent rdf:type owl:Class ;
                rdfs:subClassOf crpf:AgeRange .


###  http://www.semanticweb.org/crpf#Adult
crpf:Adult rdf:type owl:Class ;
           rdfs:subClassOf crpf:AgeRange .


###  http://www.semanticweb.org/crpf#AgeRange
crpf:AgeRange rdf:type owl:Class ;
              dc:source "NLM Medical Subject Headings (MeSH) age groups." ;
              crpf:isStandardBased "true"^^xsd:boolean ;
              crpf:standardName "MeSH age groups (custom life-stage labels)" ;
              rdfs:label "AgeRange" .


###  http://www.semanticweb.org/crpf#Aged
crpf:Aged rdf:type owl:Class ;
          rdfs:subClassOf crpf:AgeRange .


###  http://www.semanticweb.org/crpf#Agender
crpf:Agender rdf:type owl:Class ;
             rdfs:subClassOf crpf:Gender .


###  http://www.semanticweb.org/crpf#AmericanIndianOrAlaskaNative
crpf:AmericanIndianOrAlaskaNative rdf:type owl:Class ;
                                  rdfs:subClassOf crpf:Race ;
                                  rdfs:comment "A person having origins in any of the original people of North and South America (including Central America) who maintains cultural identification through tribal affiliation or community attachment." .


###  http://www.semanticweb.org/crpf#AngloCulture
crpf:AngloCulture rdf:type owl:Class ;
                  rdfs:subClassOf crpf:Culture ;
                  rdfs:label "AngloCulture" .


###  http://www.semanticweb.org/crpf#Approver
crpf:Approver rdf:type owl:Class ;
              rdfs:subClassOf crpf:Role .


###  http://www.semanticweb.org/crpf#Asian
crpf:Asian rdf:type owl:Class ;
           rdfs:subClassOf crpf:Race ;
           rdfs:comment "A person having origins in any of the original peoples of the Far East, Southeast Asia, or the Indian subcontinent, including, for example, Cambodia, China, India, Japan, Korea, Malaysia, Pakistan, the Philippine Islands, Thailand, and Vietnam." .


###  http://www.semanticweb.org/crpf#Author
crpf:Author rdf:type owl:Class ;
            rdfs:subClassOf crpf:Role .


###  http://www.semanticweb.org/crpf#Backend
crpf:Backend rdf:type owl:Class ;
             rdfs:subClassOf crpf:Domain .


###  http://www.semanticweb.org/crpf#BigPicture
crpf:BigPicture rdf:type owl:Class ;
                rdfs:subClassOf crpf:ReviewStyle .


###  http://www.semanticweb.org/crpf#Bigender
crpf:Bigender rdf:type owl:Class ;
              rdfs:subClassOf crpf:Gender .


###  http://www.semanticweb.org/crpf#Black
crpf:Black rdf:type owl:Class ;
                            rdfs:subClassOf crpf:Race ;
                            rdfs:comment "A person having origins in any of the black racial groups of Africa." .


###  http://www.semanticweb.org/crpf#Cloud
crpf:Cloud rdf:type owl:Class ;
           rdfs:subClassOf crpf:Domain .


###  http://www.semanticweb.org/crpf#CodeOwner
crpf:CodeOwner rdf:type owl:Class ;
               rdfs:subClassOf crpf:Role .


###  http://www.semanticweb.org/crpf#Collaborative
crpf:Collaborative rdf:type owl:Class ;
                   rdfs:subClassOf crpf:ReviewStyle .


###  http://www.semanticweb.org/crpf#Concise
crpf:Concise rdf:type owl:Class ;
             rdfs:subClassOf crpf:ReviewStyle .


###  http://www.semanticweb.org/crpf#ConfucianAsianCulture
crpf:ConfucianAsianCulture rdf:type owl:Class ;
                           rdfs:subClassOf crpf:Culture ;
                           rdfs:label "ConfucianAsianCulture" .


###  http://www.semanticweb.org/crpf#Constructive
crpf:Constructive rdf:type owl:Class ;
                  rdfs:subClassOf crpf:ReviewStyle .


###  http://www.semanticweb.org/crpf#Culture
crpf:Culture rdf:type owl:Class ;
             dc:source "House et al., GLOBE study cultural clusters; Hofstede; E.B. Tylor (1871)." ;
             crpf:isStandardBased "true"^^xsd:boolean ;
             crpf:standardName "GLOBE cultural clusters; Hofstede; Tylor (1871)" ;
             rdfs:label "Culture" .


###  http://www.semanticweb.org/crpf#DataDomain
crpf:DataDomain rdf:type owl:Class ;
                rdfs:subClassOf crpf:Domain .


###  http://www.semanticweb.org/crpf#Demigender
crpf:Demigender rdf:type owl:Class ;
                rdfs:subClassOf crpf:Gender .


###  http://www.semanticweb.org/crpf#Detailed
crpf:Detailed rdf:type owl:Class ;
              rdfs:subClassOf crpf:ReviewStyle .


###  http://www.semanticweb.org/crpf#DevOps
crpf:DevOps rdf:type owl:Class ;
            rdfs:subClassOf crpf:Domain .


###  http://www.semanticweb.org/crpf#Domain
crpf:Domain rdf:type owl:Class ;
            crpf:isStandardBased "false"^^xsd:boolean ;
            crpf:standardName "Custom" ;
            rdfs:label "Domain" .


###  http://www.semanticweb.org/crpf#EasternEuropeanCulture
crpf:EasternEuropeanCulture rdf:type owl:Class ;
                            rdfs:subClassOf crpf:Culture ;
                            rdfs:label "EasternEuropeanCulture" .


###  http://www.semanticweb.org/crpf#Educational
crpf:Educational rdf:type owl:Class ;
                 rdfs:subClassOf crpf:ReviewStyle .


###  http://www.semanticweb.org/crpf#Elderly
crpf:Elderly rdf:type owl:Class ;
             rdfs:subClassOf crpf:AgeRange .


###  http://www.semanticweb.org/crpf#Embedded
crpf:Embedded rdf:type owl:Class ;
              rdfs:subClassOf crpf:Domain .


###  http://www.semanticweb.org/crpf#FastDelivery
crpf:FastDelivery rdf:type owl:Class ;
                  rdfs:subClassOf crpf:Goal .


###  http://www.semanticweb.org/crpf#Fellow
crpf:Fellow rdf:type owl:Class ;
            rdfs:subClassOf crpf:Seniority .


###  http://www.semanticweb.org/crpf#Frontend
crpf:Frontend rdf:type owl:Class ;
              rdfs:subClassOf crpf:Domain .


###  http://www.semanticweb.org/crpf#FullStack
crpf:FullStack rdf:type owl:Class ;
               rdfs:subClassOf crpf:Domain .


###  http://www.semanticweb.org/crpf#Gender
crpf:Gender rdf:type owl:Class .


###  http://www.semanticweb.org/crpf#Genderfluid
crpf:Genderfluid rdf:type owl:Class ;
                 rdfs:subClassOf crpf:Gender .


###  http://www.semanticweb.org/crpf#Genderqueer
crpf:Genderqueer rdf:type owl:Class ;
                 rdfs:subClassOf crpf:Gender .


###  http://www.semanticweb.org/crpf#GermanicEuropeanCulture
crpf:GermanicEuropeanCulture rdf:type owl:Class ;
                             rdfs:subClassOf crpf:Culture ;
                             rdfs:label "GermanicEuropeanCulture" .


###  http://www.semanticweb.org/crpf#Goal
crpf:Goal rdf:type owl:Class ;
          crpf:isStandardBased "false"^^xsd:boolean ;
          rdfs:comment "What the reviewer aims to achieve (from persona templates, e.g. 'ship secure, maintainable code')." ;
          rdfs:label "Goal" .


###  http://www.semanticweb.org/crpf#HispanicOrLatino
crpf:HispanicOrLatino rdf:type owl:Class ;
              rdfs:subClassOf crpf:Race ;
              rdfs:comment "A person of Cuban, Mexican, Puerto Rican, South or Central American, or other Spanish culture or origin, regardless of race." .


###  http://www.semanticweb.org/crpf#Intern
crpf:Intern rdf:type owl:Class ;
            rdfs:subClassOf crpf:Seniority .


###  http://www.semanticweb.org/crpf#Junior
crpf:Junior rdf:type owl:Class ;
            rdfs:subClassOf crpf:Seniority .


###  http://www.semanticweb.org/crpf#LateCareerAdult
crpf:LateCareerAdult rdf:type owl:Class ;
                     rdfs:subClassOf crpf:AgeRange .


###  http://www.semanticweb.org/crpf#LatinAmericanCulture
crpf:LatinAmericanCulture rdf:type owl:Class ;
                          rdfs:subClassOf crpf:Culture ;
                          rdfs:label "LatinAmericanCulture" .


###  http://www.semanticweb.org/crpf#LatinEuropeanCulture
crpf:LatinEuropeanCulture rdf:type owl:Class ;
                          rdfs:subClassOf crpf:Culture ;
                          rdfs:label "LatinEuropeanCulture" .


###  http://www.semanticweb.org/crpf#ML
crpf:ML rdf:type owl:Class ;
        rdfs:subClassOf crpf:Domain .


###  http://www.semanticweb.org/crpf#MaintainableCode
crpf:MaintainableCode rdf:type owl:Class ;
                      rdfs:subClassOf crpf:Goal .


###  http://www.semanticweb.org/crpf#Maintainer
crpf:Maintainer rdf:type owl:Class ;
                rdfs:subClassOf crpf:Role .


###  http://www.semanticweb.org/crpf#Male
crpf:Male rdf:type owl:Class ;
         rdfs:subClassOf crpf:Gender .


###  http://www.semanticweb.org/crpf#Mid
crpf:Mid rdf:type owl:Class ;
         rdfs:subClassOf crpf:Seniority .


###  http://www.semanticweb.org/crpf#MidCareerAdult
crpf:MidCareerAdult rdf:type owl:Class ;
                    rdfs:subClassOf crpf:AgeRange .


###  http://www.semanticweb.org/crpf#MiddleAged
crpf:MiddleAged rdf:type owl:Class ;
                rdfs:subClassOf crpf:AgeRange .


###  http://www.semanticweb.org/crpf#MiddleEasternCulture
crpf:MiddleEasternCulture rdf:type owl:Class ;
                          rdfs:subClassOf crpf:Culture ;
                          rdfs:label "MiddleEasternCulture" .


###  http://www.semanticweb.org/crpf#Mobile
crpf:Mobile rdf:type owl:Class ;
            rdfs:subClassOf crpf:Domain .


###  http://www.semanticweb.org/crpf#Nationality
crpf:Nationality rdf:type owl:Class ;
                 rdfs:comment "The 12 Nationality values form six within-continent matched pairs, each with one higher-resource and one lower-resource nationality (crpf:resourceLevel). Resource level is continent-relative, operationalized via the World Bank income classification (crpf:incomeGroup). Values are UN member-state demonyms. See World Bank Country and Lending Groups for income classifications, and Kamruzzaman and Kim (2024), arXiv:2406.13993, for the persona and region-balancing methodology." ;
                 rdfs:seeAlso <https://datahelpdesk.worldbank.org/knowledgebase/articles/906519-world-bank-country-and-lending-groups> .

###  http://www.semanticweb.org/crpf#continent
crpf:continent rdf:type owl:AnnotationProperty .


###  http://www.semanticweb.org/crpf#resourceLevel
crpf:resourceLevel rdf:type owl:AnnotationProperty .


###  http://www.semanticweb.org/crpf#incomeGroup
crpf:incomeGroup rdf:type owl:AnnotationProperty .


###  http://www.semanticweb.org/crpf#SouthAfrican
crpf:SouthAfrican rdf:type owl:Class ;
           rdfs:subClassOf crpf:Nationality ;
           crpf:continent "Africa" ;
           crpf:resourceLevel "high" ;
           crpf:incomeGroup "Upper-middle income" ;
           rdfs:label "South African" .

###  http://www.semanticweb.org/crpf#SouthAfrican
crpf:SouthAfrican rdf:type owl:NamedIndividual ,
                    crpf:SouthAfrican .

###  http://www.semanticweb.org/crpf#Nigerian
crpf:Nigerian rdf:type owl:Class ;
           rdfs:subClassOf crpf:Nationality ;
           crpf:continent "Africa" ;
           crpf:resourceLevel "low" ;
           crpf:incomeGroup "Lower-middle income" ;
           rdfs:label "Nigerian" .

###  http://www.semanticweb.org/crpf#Nigerian
crpf:Nigerian rdf:type owl:NamedIndividual ,
                    crpf:Nigerian .

###  http://www.semanticweb.org/crpf#Japanese
crpf:Japanese rdf:type owl:Class ;
           rdfs:subClassOf crpf:Nationality ;
           crpf:continent "Asia" ;
           crpf:resourceLevel "high" ;
           crpf:incomeGroup "High income" ;
           rdfs:label "Japanese" .

###  http://www.semanticweb.org/crpf#Japanese
crpf:Japanese rdf:type owl:NamedIndividual ,
                    crpf:Japanese .

###  http://www.semanticweb.org/crpf#Afghan
crpf:Afghan rdf:type owl:Class ;
           rdfs:subClassOf crpf:Nationality ;
           crpf:continent "Asia" ;
           crpf:resourceLevel "low" ;
           crpf:incomeGroup "Low income" ;
           rdfs:label "Afghan" .

###  http://www.semanticweb.org/crpf#Afghan
crpf:Afghan rdf:type owl:NamedIndividual ,
                    crpf:Afghan .

###  http://www.semanticweb.org/crpf#German
crpf:German rdf:type owl:Class ;
           rdfs:subClassOf crpf:Nationality ;
           crpf:continent "Europe" ;
           crpf:resourceLevel "high" ;
           crpf:incomeGroup "High income" ;
           rdfs:label "German" .

###  http://www.semanticweb.org/crpf#German
crpf:German rdf:type owl:NamedIndividual ,
                    crpf:German .

###  http://www.semanticweb.org/crpf#Ukrainian
crpf:Ukrainian rdf:type owl:Class ;
