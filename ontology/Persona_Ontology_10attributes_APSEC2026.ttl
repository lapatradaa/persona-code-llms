           crpf:resourceLevel "low" ;
           crpf:incomeGroup "Upper-middle income" ;
           rdfs:label "Ukrainian" .

###  http://www.semanticweb.org/crpf#Ukrainian
crpf:Ukrainian rdf:type owl:NamedIndividual ,
                    crpf:Ukrainian .

