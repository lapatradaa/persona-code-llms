                crpf:hasDomain crpf:Backend ;
                crpf:hasGender crpf:Male ;
                crpf:hasNationality crpf:Japanese ;
                crpf:hasNativeLanguage crpf:ThaiLang ;
                crpf:hasReviewStyle crpf:Supportive ;
                crpf:hasRole crpf:Reviewer ;
                crpf:hasSeniority crpf:Junior ;
                crpf:hasName "P2 - Junior Backend Reviewer (TH)" ;
                crpf:hasSpecificAge 24 ;
                crpf:hasYearsExperience 2.0 .


