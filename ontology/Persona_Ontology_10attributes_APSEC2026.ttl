###  http://www.semanticweb.org/crpf#Persona_P1
crpf:Persona_P1 rdf:type owl:NamedIndividual ;
                crpf:counterfactualOf crpf:Persona_P2 ;
                crpf:hasAgeRange crpf:YoungAdult ;
                crpf:hasCulture crpf:ThaiCulture ;
                crpf:hasDomain crpf:Backend ;
                crpf:hasGender crpf:Female ;
                crpf:hasNationality crpf:Japanese ;
                crpf:hasNativeLanguage crpf:ThaiLang ;
                crpf:hasReviewStyle crpf:Supportive ;
                crpf:hasRole crpf:Reviewer ;
                crpf:hasSeniority crpf:Junior ;
                crpf:hasName "P1 - Junior Backend Reviewer (TH)" ;
                crpf:hasSpecificAge 24 ;
                crpf:hasYearsExperience 2.0 .


###  http://www.semanticweb.org/crpf#Persona_P2
crpf:Persona_P2 rdf:type owl:NamedIndividual ;
                crpf:hasAgeRange crpf:YoungAdult ;
